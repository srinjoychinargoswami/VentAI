<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules. android:allowBackup="false" covers Android 11 and
  below, but not device-to-device transfer on 12+.

  The conversation box is encrypted with a key held in flutter_secure_storage
  (wrapped by the Android Keystore, which never leaves the device). A restored
  box or key without its partner is unreadable, so none of them may travel.
  Hive's documents directory on Android is app_flutter/ (domain "root").
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/conversations.hive" />
        <exclude domain="root" path="app_flutter/conversations.lock" />
        <exclude domain="root" path="app_flutter/conversations.hive.pre-encryption-v2" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/conversations.hive" />
        <exclude domain="root" path="app_flutter/conversations.lock" />
        <exclude domain="root" path="app_flutter/conversations.hive.pre-encryption-v2" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
